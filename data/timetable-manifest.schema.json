{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rara2g4.github.io/ClassView/data/timetable-manifest.schema.json",
  "title": "ClassView timetable manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "academicYear", "updatedAt", "version", "months"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "academicYear": { "type": "string", "pattern": "^20[0-9]{2}(?:-20[0-9]{2})?$" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "version": { "type": "string", "pattern": "^[a-f0-9]{12}$" },
    "months": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$" }
    }
  }
}
