{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rara2g4.github.io/ClassView/data/timetable-manifest.schema.json",
  "title": "ClassView timetable manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "academicYear", "termPeriods", "homerooms", "updatedAt", "version", "months"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "academicYear": { "type": "string", "pattern": "^20[0-9]{2}(?:-20[0-9]{2})?$" },
    "termPeriods": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/termPeriod" }
    },
    "homerooms": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/homeroom" }
    },
    "updatedAt": { "type": "string", "format": "date-time" },
    "version": { "type": "string", "pattern": "^[a-f0-9]{12}$" },
    "months": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$" }
    }
  },
  "$defs": {
    "termPeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "startDate", "endDate"],
      "properties": {
        "term": { "enum": ["first", "second"] },
        "startDate": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "endDate": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        }
      }
    },
    "homeroom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "grade", "label"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "grade": { "type": "integer", "minimum": 1, "maximum": 3 },
        "label": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    }
  }
}
