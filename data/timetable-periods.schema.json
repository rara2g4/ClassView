{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rara2g4.github.io/ClassView/data/timetable-periods.schema.json",
  "title": "ClassView timetable periods",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "periods"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "periods": {
      "type": "object",
      "additionalProperties": false,
      "required": ["1", "2", "3", "4"],
      "properties": {
        "1": { "$ref": "#/$defs/timeRange" },
        "2": { "$ref": "#/$defs/timeRange" },
        "3": { "$ref": "#/$defs/timeRange" },
        "4": { "$ref": "#/$defs/timeRange" }
      }
    }
  },
  "$defs": {
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
        "end": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" }
      }
    }
  }
}
